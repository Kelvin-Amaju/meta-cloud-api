########################################
# APPLICATION
########################################

APP_NAME="Netgrity WhatsApp API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
# Public base URL used to build OAuth / Embedded Signup / webhook callback URLs.
# Must be reachable (HTTPS) for Meta in production, e.g. https://api.netgrity.com

########################################
# SECURITY
########################################

# Base64-encoded 32-byte (256-bit) AES key used to encrypt stored access tokens.
# Generate one with:
#   php -r "echo base64_encode(openssl_random_pseudo_bytes(32)), PHP_EOL;"
# REQUIRED — business saves are rejected (fail-closed) when this is missing/invalid.
APP_ENCRYPTION_KEY=

########################################
# META / WHATSAPP CLOUD API
########################################

META_API_VERSION=v25.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
# From the Meta app dashboard: https://developers.facebook.com/apps/<id>/settings/basic
META_APP_ID=
META_APP_SECRET=

# Classic OAuth callback URL (also used by callback.php). Default: http://localhost/callback.php
CALLBACK_URL=http://localhost/callback.php

########################################
# DATABASE
########################################

DB_HOST=localhost
DB_PORT=3306
DB_NAME=netgrity_wa
DB_USER=root
DB_PASS=
